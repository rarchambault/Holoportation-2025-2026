#pragma kernel CSClear
#pragma kernel CSMain
#pragma kernel CSMarch

#include "MarchingCubesTables.cginc"

// --- Variables ---
StructuredBuffer<float3> PositionBuffer;
StructuredBuffer<uint> ColorBuffer; // Packed Color32
int NumPoints;
int GridResolution;

// float4 grid: xyz = Color, w = Density
RWTexture3D<float4> DensityGrid;

struct Triangle
{
    float3 vertexA;
    float3 vertexB;
    float3 vertexC;
    float3 padding;
    float4 color;
};

AppendStructuredBuffer<Triangle> OutputTriangles;

float3 VertexInterp(float isoLevel, float3 p1, float3 p2, float valp1, float valp2)
{
    if (abs(isoLevel - valp1) < 0.00001)
        return p1;
    if (abs(isoLevel - valp2) < 0.00001)
        return p2;
    if (abs(valp1 - valp2) < 0.00001)
        return p1;
    float mu = (isoLevel - valp1) / (valp2 - valp1);
    return p1 + mu * (p2 - p1);
}

[numthreads(8, 8, 8)]
void CSClear(uint3 id : SV_DispatchThreadID)
{
    DensityGrid[id] = float4(0, 0, 0, 0);
}

[numthreads(64, 1, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint) NumPoints)
        return;
    
    float3 pos = PositionBuffer[id.x];
    
    // --- MANUAL UNPACKING ---
    uint packedColor = ColorBuffer[id.x];
    float4 ptCol;
    ptCol.r = (float) (packedColor & 0xFF) / 255.0;
    ptCol.g = (float) ((packedColor >> 8) & 0xFF) / 255.0;
    ptCol.b = (float) ((packedColor >> 16) & 0xFF) / 255.0;
    ptCol.a = (float) ((packedColor >> 24) & 0xFF) / 255.0;
    // ------------------------

    float3 offset = float3(0.15f, 0.15f, 0.0f);
    float3 gridPos = (pos + offset) * (GridResolution / 0.3f);
    int3 voxelCoords = (int3) gridPos;

    if (voxelCoords.x >= 0 && voxelCoords.x < GridResolution &&
        voxelCoords.y >= 0 && voxelCoords.y < GridResolution &&
        voxelCoords.z >= 0 && voxelCoords.z < GridResolution)
    {
        // Store RGB in xyz, and Density (1.0) in w
        DensityGrid[voxelCoords] = float4(ptCol.rgb, 1.0);
    }
}

[numthreads(8, 8, 8)]
void CSMarch(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint) (GridResolution - 1) || id.y >= (uint) (GridResolution - 1) || id.z >= (uint) (GridResolution - 1))
        return;

    // Sample Density from the .w component
    float cubeValues[8];
    cubeValues[0] = DensityGrid[id + uint3(0, 0, 1)].w;
    cubeValues[1] = DensityGrid[id + uint3(1, 0, 1)].w;
    cubeValues[2] = DensityGrid[id + uint3(1, 0, 0)].w;
    cubeValues[3] = DensityGrid[id + uint3(0, 0, 0)].w;
    cubeValues[4] = DensityGrid[id + uint3(0, 1, 1)].w;
    cubeValues[5] = DensityGrid[id + uint3(1, 1, 1)].w;
    cubeValues[6] = DensityGrid[id + uint3(1, 1, 0)].w;
    cubeValues[7] = DensityGrid[id + uint3(0, 1, 0)].w;

    float isoLevel = 0.5;
    int cubeIndex = 0;
    if (cubeValues[0] > isoLevel)
        cubeIndex |= 1;
    if (cubeValues[1] > isoLevel)
        cubeIndex |= 2;
    if (cubeValues[2] > isoLevel)
        cubeIndex |= 4;
    if (cubeValues[3] > isoLevel)
        cubeIndex |= 8;
    if (cubeValues[4] > isoLevel)
        cubeIndex |= 16;
    if (cubeValues[5] > isoLevel)
        cubeIndex |= 32;
    if (cubeValues[6] > isoLevel)
        cubeIndex |= 64;
    if (cubeValues[7] > isoLevel)
        cubeIndex |= 128;

    if (edgeTable[cubeIndex] == 0 || edgeTable[cubeIndex] == 255)
        return;

    float scale = 0.3f / GridResolution;
    float3 cubePositions[8];
    for (int i = 0; i < 8; i++)
        cubePositions[i] = ((float3(id) + cornerOffsets[i]) * scale) - float3(0.15f, 0.15f, 0.0f);

    float3 vertList[12];
    int edgeFlags = edgeTable[cubeIndex];
    if (edgeFlags & 1)
        vertList[0] = VertexInterp(isoLevel, cubePositions[0], cubePositions[1], cubeValues[0], cubeValues[1]);
    if (edgeFlags & 2)
        vertList[1] = VertexInterp(isoLevel, cubePositions[1], cubePositions[2], cubeValues[1], cubeValues[2]);
    if (edgeFlags & 4)
        vertList[2] = VertexInterp(isoLevel, cubePositions[2], cubePositions[3], cubeValues[2], cubeValues[3]);
    if (edgeFlags & 8)
        vertList[3] = VertexInterp(isoLevel, cubePositions[3], cubePositions[0], cubeValues[3], cubeValues[0]);
    if (edgeFlags & 16)
        vertList[4] = VertexInterp(isoLevel, cubePositions[4], cubePositions[5], cubeValues[4], cubeValues[5]);
    if (edgeFlags & 32)
        vertList[5] = VertexInterp(isoLevel, cubePositions[5], cubePositions[6], cubeValues[5], cubeValues[6]);
    if (edgeFlags & 64)
        vertList[6] = VertexInterp(isoLevel, cubePositions[6], cubePositions[7], cubeValues[6], cubeValues[7]);
    if (edgeFlags & 128)
        vertList[7] = VertexInterp(isoLevel, cubePositions[7], cubePositions[4], cubeValues[7], cubeValues[4]);
    if (edgeFlags & 256)
        vertList[8] = VertexInterp(isoLevel, cubePositions[0], cubePositions[4], cubeValues[0], cubeValues[4]);
    if (edgeFlags & 512)
        vertList[9] = VertexInterp(isoLevel, cubePositions[1], cubePositions[5], cubeValues[1], cubeValues[5]);
    if (edgeFlags & 1024)
        vertList[10] = VertexInterp(isoLevel, cubePositions[2], cubePositions[6], cubeValues[2], cubeValues[6]);
    if (edgeFlags & 2048)
        vertList[11] = VertexInterp(isoLevel, cubePositions[3], cubePositions[7], cubeValues[3], cubeValues[7]);

    // Use the color from the current grid cell
    float4 meshColor = float4(DensityGrid[id].rgb, 1.0);

    for (int j = 0; triTable[cubeIndex][j] != -1; j += 3)
    {
        Triangle tri;
        tri.vertexA = vertList[triTable[cubeIndex][j]];
        tri.vertexB = vertList[triTable[cubeIndex][j + 1]];
        tri.vertexC = vertList[triTable[cubeIndex][j + 2]];
        tri.padding = float3(0, 0, 0);
        tri.color = meshColor;
        OutputTriangles.Append(tri);
    }
}